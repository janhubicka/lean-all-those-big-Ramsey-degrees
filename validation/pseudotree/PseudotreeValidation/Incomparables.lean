import PseudotreeValidation.ProfilesModel
import PseudotreeValidation.FiniteOscillation
import PseudotreeValidation.FiniteExtensions

/-!
# Unavoidable colours on incomparable pairs

The enumeration defining the colouring is fixed once in the ambient ternary
model. The theorems quantify over actual self-embeddings in the functional
language `{≤, ∧}`. The end-extension hypothesis of the finite-set oscillation
lemma is discharged by the geometric profile construction.
-/

namespace AllThoseBigRamsey.Pseudotree

open FirstOrder
open scoped FirstOrder

namespace Incomparables

open Profiles FiniteOscillation

/-- Comparable points have nested profiles, hence oscillation at most one. -/
theorem profile_osc_le_one {a b : TernaryModel} (hab : a ≤ b ∨ b ≤ a) :
    osc (ternarySystem.profile a) (ternarySystem.profile b) ≤ 1 := by
  rcases hab with hab | hba
  · exact osc_le_one_of_subset (ternarySystem.profile_monotone hab)
  · rw [osc_symm]
    exact osc_le_one_of_subset (ternarySystem.profile_monotone hba)

/-- Every oscillation at least two is attained by an incomparable pair in
every actual functional self-copy of the ternary model. -/
theorem every_oscillation (f : TernaryModel ↪[language] TernaryModel)
    (k : ℕ) (hk : 2 ≤ k) :
    ∃ a b, a ∈ Set.range f ∧ b ∈ Set.range f ∧ ¬a ≤ b ∧ ¬b ≤ a ∧
      osc (ternarySystem.profile a) (ternarySystem.profile b) = k := by
  obtain ⟨s, t, hs, ht, hosc⟩ := FiniteOscillation.all_oscillations
    (ternarySystem.Repeated (Set.range f)) (ternary_copy_repeated_nonempty f)
    (fun _ hs N => ternary_copy_endExtension f hs N) k
  obtain ⟨u, hu, a, ha, hua, hus, has⟩ := hs
  obtain ⟨v, hv, b, hb, hvb, hvt, hbt⟩ := ht
  have habosc : osc (ternarySystem.profile a) (ternarySystem.profile b) = k := by
    simpa only [has, hbt] using hosc
  refine ⟨a, b, ha, hb, ?_, ?_, habosc⟩
  · intro hab
    have hbound := profile_osc_le_one (Or.inl hab)
    omega
  · intro hba
    have hbound := profile_osc_le_one (Or.inr hba)
    omega

/-- A fixed ambient finite colouring of pairs by their profile oscillation. -/
noncomputable def pairColour (m : ℕ) (hm : 0 < m) (a b : TernaryModel) : Fin m :=
  ⟨osc (ternarySystem.profile a) (ternarySystem.profile b) % m, Nat.mod_lt _ hm⟩

theorem pairColour_symm (m : ℕ) (hm : 0 < m) (a b : TernaryModel) :
    pairColour m hm a b = pairColour m hm b a := by
  apply Fin.ext
  simp only [pairColour, osc_symm]

/-- Every residue is seen on incomparable points in every self-copy, for one
fixed colouring of the ambient model. -/
theorem every_pairColour (m : ℕ) (hm : 0 < m)
    (f : TernaryModel ↪[language] TernaryModel) (i : Fin m) :
    ∃ a b, a ∈ Set.range f ∧ b ∈ Set.range f ∧ ¬a ≤ b ∧ ¬b ≤ a ∧
      pairColour m hm a b = i := by
  obtain ⟨a, b, ha, hb, hab, hba, hosc⟩ := every_oscillation f (i.val + 2 * m) (by omega)
  refine ⟨a, b, ha, hb, hab, hba, ?_⟩
  apply Fin.ext
  simp [pairColour, hosc, Nat.add_mod, Nat.mod_eq_of_lt i.isLt]

/-- The functional substructure generated by two incomparable points. -/
inductive Fork where
  | root | left | right
  deriving DecidableEq

namespace Fork

instance : Fintype Fork where
  elems := {root, left, right}
  complete := by intro x; cases x <;> simp

def meet : Fork → Fork → Fork
  | .left, .left => .left
  | .right, .right => .right
  | _, _ => .root

instance : SemilatticeInf Fork where
  le a b := a = .root ∨ a = b
  le_refl _ := Or.inr rfl
  le_trans := by decide
  le_antisymm := by decide
  inf := meet
  inf_le_left := by decide
  inf_le_right := by decide
  le_inf := by decide

def map {M : Type*} [SemilatticeInf M] (a b : M) : Fork → M
  | .root => a ⊓ b
  | .left => a
  | .right => b

theorem map_injective {M : Type*} [SemilatticeInf M] {a b : M}
    (hab : ¬a ≤ b) (hba : ¬b ≤ a) : Function.Injective (map a b) := by
  intro x y h
  have hab' : a ≠ b := fun h => hab (h ▸ le_refl a)
  cases x <;> cases y <;>
    simp_all [map, eq_comm]

theorem map_inf {M : Type*} [SemilatticeInf M] (a b : M) (x y : Fork) :
    map a b (x ⊓ y) = map a b x ⊓ map a b y := by
  change map a b (meet x y) = map a b x ⊓ map a b y
  cases x <;> cases y <;>
    simp [map, meet, inf_comm]

/-- Every incomparable pair determines an actual functional embedding of the fork. -/
def embedding {M : Type*} [SemilatticeInf M] [language.Structure M]
    [MeetsInterpreted M] {a b : M}
    (hab : ¬a ≤ b) (hba : ¬b ≤ a) : Fork ↪[language] M :=
  embeddingOfInfMap (map a b) (map_injective hab hba) (map_inf a b)

@[simp] theorem embedding_left {M : Type*} [SemilatticeInf M] [language.Structure M]
    [MeetsInterpreted M] {a b : M}
    (hab : ¬a ≤ b) (hba : ¬b ≤ a) : embedding hab hba .left = a := rfl

@[simp] theorem embedding_right {M : Type*} [SemilatticeInf M] [language.Structure M]
    [MeetsInterpreted M] {a b : M}
    (hab : ¬a ≤ b) (hba : ¬b ≤ a) : embedding hab hba .right = b := rfl

end Fork

/-- The concrete model's proved ultrahomogeneity extends any specified
incomparable pair to any finite pattern containing an incomparable pair. -/
theorem extend_incomparable_pair {A : Type*} [SemilatticeInf A]
    [language.Structure A] [MeetsInterpreted A]
    (hA : Nonempty (A ↪[language] TernaryModel))
    {x y : A} (hxy : ¬x ≤ y) (hyx : ¬y ≤ x)
    {a b : TernaryModel} (hab : ¬a ≤ b) (hba : ¬b ≤ a) :
    ∃ e : A ↪[language] TernaryModel, e x = a ∧ e y = b := by
  have hhom : language.IsUltrahomogeneous TernaryModel := RayTree.isUltrahomogeneous
  obtain ⟨e, he⟩ := hhom.extend_embedding
    (FirstOrder.Language.Structure.FG.of_finite : FirstOrder.Language.Structure.FG language Fork)
    (Fork.embedding hab hba) (Fork.embedding hxy hyx) (h := hA)
  refine ⟨e, ?_, ?_⟩
  · have h := congrArg (fun g : Fork ↪[language] TernaryModel => g Fork.left) he
    simpa using h.symm
  · have h := congrArg (fun g : Fork ↪[language] TernaryModel => g Fork.right) he
    simpa using h.symm

/-- Colour a finite copy by all pair colours occurring in it. This removes
any dependence on a labelling of that finite copy. -/
noncomputable def pairPalette {A : Type*} [Fintype A] [SemilatticeInf A]
    [language.Structure A] [MeetsInterpreted A]
    (m : ℕ) (hm : 0 < m) (e : A ↪[language] TernaryModel) : Finset (Fin m) := by
  classical
  exact (Finset.univ.filter (fun p : A × A => ¬p.1 ≤ p.2 ∧ ¬p.2 ≤ p.1)).image
    (fun p => pairColour m hm (e p.1) (e p.2))

theorem mem_pairPalette {A : Type*} [Fintype A] [SemilatticeInf A]
    [language.Structure A] [MeetsInterpreted A]
    (m : ℕ) (hm : 0 < m) (e : A ↪[language] TernaryModel) (i : Fin m) :
    i ∈ pairPalette m hm e ↔
      ∃ x y, ¬x ≤ y ∧ ¬y ≤ x ∧ pairColour m hm (e x) (e y) = i := by
  classical
  simp only [pairPalette, Finset.mem_image, Finset.mem_filter, Finset.mem_univ,
    true_and, Prod.exists]
  aesop

/-- Each set-valued colour has at most the square of the pattern's size elements. -/
theorem pairPalette_card_le {A : Type*} [Fintype A] [SemilatticeInf A]
    [language.Structure A] [MeetsInterpreted A]
    (m : ℕ) (hm : 0 < m) (e : A ↪[language] TernaryModel) :
    (pairPalette m hm e).card ≤ Fintype.card A ^ 2 := by
  classical
  calc
    (pairPalette m hm e).card ≤
        (Finset.univ.filter (fun p : A × A => ¬p.1 ≤ p.2 ∧ ¬p.2 ≤ p.1)).card :=
      Finset.card_image_le
    _ ≤ (Finset.univ : Finset (A × A)).card := Finset.card_filter_le _ _
    _ = Fintype.card A ^ 2 := by simp [pow_two]

theorem pairPalette_subset_of_range_subset {A B : Type*} [Fintype A] [Fintype B]
    [SemilatticeInf A] [SemilatticeInf B]
    [language.Structure A] [MeetsInterpreted A] [language.Structure B] [MeetsInterpreted B]
    (m : ℕ) (hm : 0 < m) (e : A ↪[language] TernaryModel)
    (g : B ↪[language] TernaryModel) (hrange : Set.range e ⊆ Set.range g) :
    pairPalette m hm e ⊆ pairPalette m hm g := by
  classical
  intro i hi
  obtain ⟨x, y, hxy, hyx, hc⟩ := (mem_pairPalette m hm e i).mp hi
  obtain ⟨u, hu⟩ := hrange (Set.mem_range_self x)
  obtain ⟨v, hv⟩ := hrange (Set.mem_range_self y)
  apply (mem_pairPalette m hm g i).mpr
  refine ⟨u, v, ?_, ?_, ?_⟩
  · intro huv
    have h : g u ≤ g v := (embeddingOrderEmbedding g).monotone huv
    rw [hu, hv] at h
    exact hxy ((embeddingOrderEmbedding e).le_iff_le.mp h)
  · intro hvu
    have h : g v ≤ g u := (embeddingOrderEmbedding g).monotone hvu
    rw [hu, hv] at h
    exact hyx ((embeddingOrderEmbedding e).le_iff_le.mp h)
  · simpa only [hu, hv] using hc

/-- The colouring depends only on the actual finite subcopy, even if its
carrier or labelling is changed. -/
theorem pairPalette_eq_of_range_eq {A B : Type*} [Fintype A] [Fintype B]
    [SemilatticeInf A] [SemilatticeInf B]
    [language.Structure A] [MeetsInterpreted A] [language.Structure B] [MeetsInterpreted B]
    (m : ℕ) (hm : 0 < m) (e : A ↪[language] TernaryModel)
    (g : B ↪[language] TernaryModel) (hrange : Set.range e = Set.range g) :
    pairPalette m hm e = pairPalette m hm g :=
  Finset.Subset.antisymm (pairPalette_subset_of_range_subset m hm e g hrange.subset)
    (pairPalette_subset_of_range_subset m hm g e hrange.symm.subset)

/-- All pair residues occur among the set-valued colours of copies of any
pattern containing incomparable points, inside every self-copy. -/
theorem every_colour_in_pattern {A : Type*} [Fintype A] [SemilatticeInf A]
    [language.Structure A] [MeetsInterpreted A]
    (hA : Nonempty (A ↪[language] TernaryModel))
    {x y : A} (hxy : ¬x ≤ y) (hyx : ¬y ≤ x)
    (m : ℕ) (hm : 0 < m) (f : TernaryModel ↪[language] TernaryModel) (i : Fin m) :
    ∃ e : A ↪[language] TernaryModel, i ∈ pairPalette m hm (f.comp e) := by
  obtain ⟨a, b, ⟨u, rfl⟩, ⟨v, rfl⟩, hab, hba, hc⟩ := every_pairColour m hm f i
  have huv : ¬u ≤ v := fun h => hab ((functionalOrderEmbedding f).monotone h)
  have hvu : ¬v ≤ u := fun h => hba ((functionalOrderEmbedding f).monotone h)
  obtain ⟨e, hex, hey⟩ := extend_incomparable_pair hA hxy hyx huv hvu
  refine ⟨e, (mem_pairPalette m hm (f.comp e) i).mpr ⟨x, y, hxy, hyx, ?_⟩⟩
  simpa only [FirstOrder.Language.Embedding.comp_apply, hex, hey] using hc

/-- The usual finite bound definition, with functional embeddings and a
finite set of colours. The colouring constructed below is image-invariant,
so the lower bound also applies when finite copies are coloured instead. -/
def FunctionalBigRamseyBound (A : Type*) [language.Structure A] (d : ℕ) : Prop :=
  ∀ r : ℕ, 0 < r → ∀ χ : (A ↪[language] TernaryModel) → Fin r,
    ∃ f : TernaryModel ↪[language] TernaryModel, ∃ palette : Finset (Fin r),
      palette.card ≤ d ∧ ∀ e : A ↪[language] TernaryModel, χ (f.comp e) ∈ palette

/-- The finite colour space used to encode sets of pair residues. -/
abbrev BoundedPalette (m K : ℕ) := {s : Finset (Fin m) // s.card ≤ K}

/-- For every proposed bound there is a finite, image-invariant colouring
requiring more colours in every functional self-copy. No Ramsey, profile,
ultrahomogeneity, or extension principle is assumed in this statement. -/
theorem arbitrarily_many_copy_colours {A : Type*} [Fintype A] [SemilatticeInf A]
    [language.Structure A] [MeetsInterpreted A]
    (hA : Nonempty (A ↪[language] TernaryModel))
    {x y : A} (hxy : ¬x ≤ y) (hyx : ¬y ≤ x) (d : ℕ) :
    ∃ r : ℕ, ∃ _hr : 0 < r, ∃ χ : (A ↪[language] TernaryModel) → Fin r,
      (∀ e g : A ↪[language] TernaryModel, Set.range e = Set.range g → χ e = χ g) ∧
      ∀ f : TernaryModel ↪[language] TernaryModel, ∀ palette : Finset (Fin r),
        (∀ e : A ↪[language] TernaryModel, χ (f.comp e) ∈ palette) → d < palette.card := by
  classical
  let K := Fintype.card A ^ 2
  let m := d * K + 1
  have hm : 0 < m := by dsimp [m]; omega
  let r := Fintype.card (BoundedPalette m K)
  have hr : 0 < r := Fintype.card_pos_iff.mpr ⟨⟨∅, by simp⟩⟩
  let encode := Fintype.equivFin (BoundedPalette m K)
  let χ : (A ↪[language] TernaryModel) → Fin r := fun e =>
    encode ⟨pairPalette m hm e, pairPalette_card_le m hm e⟩
  let decode : Fin r → Finset (Fin m) := fun c => (encode.symm c).val
  have hdecode (c : Fin r) : (decode c).card ≤ K := (encode.symm c).property
  have hχ (e : A ↪[language] TernaryModel) : decode (χ e) = pairPalette m hm e := by
    simp only [decode, χ, Equiv.symm_apply_apply]
  refine ⟨r, hr, χ, ?_, ?_⟩
  · intro e g hrange
    apply encode.injective.eq_iff.mpr
    apply Subtype.ext
    exact pairPalette_eq_of_range_eq m hm e g hrange
  · intro f palette hcover
    have hfull : (Finset.univ : Finset (Fin m)) ⊆ palette.biUnion decode := by
      intro i _
      obtain ⟨e, hi⟩ := every_colour_in_pattern hA hxy hyx m hm f i
      apply Finset.mem_biUnion.mpr
      exact ⟨χ (f.comp e), hcover e, by simpa only [hχ] using hi⟩
    have hbound : m ≤ palette.card * K := calc
      m = (Finset.univ : Finset (Fin m)).card := by simp
      _ ≤ (palette.biUnion decode).card := Finset.card_le_card hfull
      _ ≤ ∑ c ∈ palette, (decode c).card := Finset.card_biUnion_le
      _ ≤ ∑ _c ∈ palette, K := Finset.sum_le_sum (fun c _ => hdecode c)
      _ = palette.card * K := by simp
    by_contra hnot
    have hle : palette.card ≤ d := Nat.le_of_not_gt hnot
    have hmul := Nat.mul_le_mul_right K hle
    dsimp [m] at hbound
    omega

/-- Every finite meet-substructure in the age containing incomparable points
has infinite big Ramsey degree in the concrete ternary model. The witness
colourings are invariant under re-enumerating the finite substructure. -/
theorem no_finite_bound {A : Type*} [Finite A] [SemilatticeInf A]
    [language.Structure A] [MeetsInterpreted A]
    (hA : Nonempty (A ↪[language] TernaryModel))
    {x y : A} (hxy : ¬x ≤ y) (hyx : ¬y ≤ x) (d : ℕ) :
    ¬FunctionalBigRamseyBound A d := by
  classical
  let _ : Fintype A := Fintype.ofFinite A
  intro hbound
  obtain ⟨r, hr, χ, _, hχ⟩ := arbitrarily_many_copy_colours hA hxy hyx d
  obtain ⟨f, palette, hcard, hcover⟩ := hbound r hr χ
  have hlarge := hχ f palette hcover
  omega

end Incomparables
end AllThoseBigRamsey.Pseudotree
